# =========================================================
# COMPARE PAGE
# =========================================================

class ComparePage:

    def __init__(
        self,
        parent,
        mode
    ):

        self.parent = parent
        self.mode = mode

        self.image1_path = ""
        self.image2_path = ""

        self.image1 = None
        self.image2 = None

        self.preview1 = None
        self.preview2 = None

        self.build()

    def build(self):

        title = (
            "Fingerprint Recognition"
            if self.mode == "fingerprint"
            else "Iris Recognition"
        )

        subtitle = (
            "Fingerprint image similarity analysis"
            if self.mode == "fingerprint"
            else "Iris image similarity analysis"
        )

        create_header(
            self.parent,
            title,
            subtitle
        )

        nav = tk.Frame(
            self.parent,
            bg=WHITE,
            height=50
        )

        nav.pack(
            fill="x"
        )

        nav.pack_propagate(False)

        create_button(
            nav,
            "← HOME",
            show_dashboard,
            width=10
        ).pack(
            side="left",
            padx=20,
            pady=7
        )

        create_button(
            nav,
            "ANALYSIS",
            show_analysis,
            width=10
        ).pack(
            side="right",
            padx=20,
            pady=7
        )

        # Main
        main = tk.Frame(
            self.parent,
            bg=BG
        )

        main.pack(
            fill="both",
            expand=True,
            padx=30,
            pady=20
        )

        # Image area
        image_area = tk.Frame(
            main,
            bg=BG
        )

        image_area.pack(
            fill="x"
        )

        self.card1 = self.create_image_card(
            image_area,
            "IMAGE 1",
            0
        )

        self.card1.pack(
            side="left",
            fill="both",
            expand=True,
            padx=(0, 10)
        )

        self.card2 = self.create_image_card(
            image_area,
            "IMAGE 2",
            1
        )

        self.card2.pack(
            side="left",
            fill="both",
            expand=True,
            padx=(10, 0)
        )

        # Control area
        controls = tk.Frame(
            main,
            bg=WHITE,
            highlightbackground=LIGHT_GRAY,
            highlightthickness=1
        )

        controls.pack(
            fill="x",
            pady=18
        )

        create_button(
            controls,
            "SELECT IMAGE 1",
            self.select_image1,
            width=18
        ).pack(
            side="left",
            padx=20,
            pady=15
        )

        create_button(
            controls,
            "SELECT IMAGE 2",
            self.select_image2,
            width=18
        ).pack(
            side="left",
            padx=5,
            pady=15
        )

        create_button(
            controls,
            "COMPARE IMAGES",
            self.compare,
            width=20,
            bg=GREEN
        ).pack(
            side="right",
            padx=20,
            pady=15
        )

        # Result
        result_box = tk.Frame(
            main,
            bg=NAVY,
            height=135
        )

        result_box.pack(
            fill="x"
        )

        result_box.pack_propagate(False)

        self.result_title = tk.Label(
            result_box,
            text="RESULT",
            font=("Arial", 13, "bold"),
            bg=NAVY,
            fg="#BFD3E3"
        )

        self.result_title.pack(
            pady=(15, 0)
        )

        self.result_label = tk.Label(
            result_box,
            text="Select two images to begin analysis",
            font=("Arial", 18, "bold"),
            bg=NAVY,
            fg=WHITE
        )

        self.result_label.pack(
            pady=4
        )

        self.score_label = tk.Label(
            result_box,
            text="Similarity: --",
            font=("Arial", 12),
            bg=NAVY,
            fg=CYAN
        )

        self.score_label.pack()

    def create_image_card(
        self,
        parent,
        title,
        number
    ):

        card = tk.Frame(
            parent,
            bg=WHITE,
            highlightbackground=LIGHT_GRAY,
            highlightthickness=1
        )

        tk.Label(
            card,
            text=title,
            font=("Arial", 13, "bold"),
            bg=WHITE,
            fg=NAVY
        ).pack(
            pady=(12, 5)
        )

        preview = tk.Label(
            card,
            text="No image selected",
            font=("Arial", 11),
            bg=LIGHT_BLUE,
            fg=GRAY,
            width=42,
            height=12
        )

        preview.pack(
            padx=15,
            pady=10
        )

        if number == 0:
            self.preview_label1 = preview
        else:
            self.preview_label2 = preview

        return card

    def select_image1(self):

        path = filedialog.askopenfilename(
            title="Select First Image",
            filetypes=[
                (
                    "Image Files",
                    "*.jpg *.jpeg *.png *.bmp *.tif *.tiff"
                ),
                (
                    "All Files",
                    "*.*"
                )
            ]
        )

        if not path:
            return

        image = read_image(path)

        if image is None:

            messagebox.showerror(
                "Error",
                "The selected image could not be opened."
            )

            return

        self.image1_path = path
        self.image1 = image

        self.update_preview(
            image,
            self.preview_label1
        )

    def select_image2(self):

        path = filedialog.askopenfilename(
            title="Select Second Image",
            filetypes=[
                (
                    "Image Files",
                    "*.jpg *.jpeg *.png *.bmp *.tif *.tiff"
                ),
                (
                    "All Files",
                    "*.*"
                )
            ]
        )

        if not path:
            return

        image = read_image(path)

        if image is None:

            messagebox.showerror(
                "Error",
                "The selected image could not be opened."
            )

            return

        self.image2_path = path
        self.image2 = image

        self.update_preview(
            image,
            self.preview_label2
        )

    def update_preview(
        self,
        image,
        label
    ):

        try:

            photo = make_preview(
                image,
                400,
                230
            )

            label.configure(
                image=photo,
                text=""
            )

            label.image = photo

        except Exception as e:

            label.configure(
                text="Preview unavailable"
            )

    def compare(self):

        if self.image1 is None or self.image2 is None:

            messagebox.showwarning(
                "Missing Images",
                "Please select both images before comparison."
            )

            return

        try:

            if self.mode == "fingerprint":

                score = fingerprint_orb_similarity(
                    self.image1,
                    self.image2
                )

                threshold = FINGERPRINT_THRESHOLD

            else:

                score = iris_similarity(
                    self.image1,
                    self.image2
                )

                threshold = IRIS_THRESHOLD

            if score >= threshold:

                result = "SIMILARITY DETECTED"
                result_color = GREEN

            else:

                result = "LOW SIMILARITY"
                result_color = RED

            self.result_label.configure(
                text=result,
                fg=result_color
            )

            self.score_label.configure(
                text=f"Similarity Score: {score}%"
            )

        except Exception as e:

            messagebox.showerror(
                "Processing Error",
                f"An error occurred during analysis:\n\n{e}"
            )


