# =========================================================
# MAIN APPLICATION
# =========================================================

def main():

    global root

    root = tk.Tk()

    root.title(
        APP_NAME
    )

    root.geometry(
        "1100x720"
    )

    root.minsize(
        950,
        650
    )

    root.configure(
        bg=BG
    )

    # Application icon can be added later
    # when the university/project logo is available.

    show_welcome()

    root.mainloop()


