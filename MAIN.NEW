# =========================================================
# ANALYSIS PAGE
# =========================================================

def show_analysis():

    clear_window()

    create_header(
        root,
        "Analysis",
        "Biometric processing methods used in this project"
    )

    nav = tk.Frame(
        root,
        bg=WHITE,
        height=50
    )

    nav.pack(
        fill="x"
    )

    nav.pack_propagate(False)

    create_button(
        nav,
        "← HOME",
        show_dashboard,
        width=10
    ).pack(
        side="left",
        padx=20,
        pady=7
    )

    main = tk.Frame(
        root,
        bg=BG
    )

    main.pack(
        fill="both",
        expand=True,
        padx=35,
        pady=25
    )

    sections = [
        (
            "Fingerprint Processing",
            [
                "1. Convert image to grayscale.",
                "2. Resize the image to a standard size.",
                "3. Apply Gaussian blur for noise reduction.",
                "4. Improve local contrast using CLAHE.",
                "5. Enhance ridge structures using morphological processing.",
                "6. Extract ORB features.",
                "7. Match descriptors using Hamming distance.",
                "8. Verify geometric consistency using RANSAC."
            ]
        ),
        (
            "Iris Processing",
            [
                "1. Convert the eye image to grayscale.",
                "2. Detect an approximate iris circle using Hough detection.",
                "3. Normalize the iris using polar transformation.",
                "4. Improve contrast using CLAHE.",
                "5. Generate a binary iris representation.",
                "6. Compare the binary patterns using Hamming distance.",
                "7. Test small rotational shifts.",
                "8. Convert the final distance into a similarity score."
            ]
        )
    ]

    for title, items in sections:

        box = tk.Frame(
            main,
            bg=WHITE,
            highlightbackground=LIGHT_GRAY,
            highlightthickness=1
        )

        box.pack(
            fill="x",
            pady=10
        )

        tk.Label(
            box,
            text=title,
            font=("Arial", 16, "bold"),
            bg=WHITE,
            fg=NAVY
        ).pack(
            anchor="w",
            padx=22,
            pady=(15, 8)
        )

        for item in items:

            tk.Label(
                box,
                text=item,
                font=("Arial", 10),
                bg=WHITE,
                fg=GRAY,
                anchor="w"
            ).pack(
                fill="x",
                padx=35,
                pady=2
            )

        tk.Label(
            box,
            text=""
        ).pack(
            pady=5
        )


