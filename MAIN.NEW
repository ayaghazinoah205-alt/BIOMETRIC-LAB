# =========================================================
# IMAGE FUNCTIONS
# =========================================================

def read_image(path):
    """Read an image safely."""

    if not path or not os.path.exists(path):
        return None

    image = cv2.imread(path)

    if image is None:
        return None

    return image


def make_preview(image, width=360, height=250):
    """Create a Tkinter-compatible preview."""

    if image is None:
        return None

    img = image.copy()

    h, w = img.shape[:2]

    scale = min(width / w, height / h)

    new_w = max(1, int(w * scale))
    new_h = max(1, int(h * scale))

    img = cv2.resize(img, (new_w, new_h))

    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

    from PIL import Image, ImageTk

    pil_img = Image.fromarray(img)
    photo = ImageTk.PhotoImage(pil_img)

    return photo


def gray_resize(image, size=(500, 500)):
    """Convert image to grayscale and resize."""

    if image is None:
        return None

    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

    gray = cv2.resize(
        gray,
        size,
        interpolation=cv2.INTER_AREA
    )

    return gray


# =========================================================
# FINGERPRINT PROCESSING
# =========================================================

def preprocess_fingerprint(image):

    gray = gray_resize(image)

    if gray is None:
        return None

    # Reduce noise
    blurred = cv2.GaussianBlur(gray, (5, 5), 0)

    # Improve local contrast
    clahe = cv2.createCLAHE(
        clipLimit=2.0,
        tileGridSize=(8, 8)
    )

    enhanced = clahe.apply(blurred)

    # Blackhat operation enhances dark ridge structures
    kernel = cv2.getStructuringElement(
        cv2.MORPH_RECT,
        (15, 15)
    )

    blackhat = cv2.morphologyEx(
        enhanced,
        cv2.MORPH_BLACKHAT,
        kernel
    )

    # Adaptive threshold
    binary = cv2.adaptiveThreshold(
        blackhat,
        255,
        cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
        cv2.THRESH_BINARY,
        21,
        5
    )

    # Morphological cleaning
    morph_kernel = np.ones((3, 3), np.uint8)

    binary = cv2.morphologyEx(
        binary,
        cv2.MORPH_OPEN,
        morph_kernel
    )

    binary = cv2.morphologyEx(
        binary,
        cv2.MORPH_CLOSE,
        morph_kernel
    )

    return binary


def fingerprint_orb_similarity(img1, img2):

    p1 = preprocess_fingerprint(img1)
    p2 = preprocess_fingerprint(img2)

    if p1 is None or p2 is None:
        return 0

    orb = cv2.ORB_create(
        nfeatures=1500
    )

    kp1, des1 = orb.detectAndCompute(p1, None)
    kp2, des2 = orb.detectAndCompute(p2, None)

    if des1 is None or des2 is None:
        return 0

    if len(kp1) < 4 or len(kp2) < 4:
        return 0

    matcher = cv2.BFMatcher(
        cv2.NORM_HAMMING
    )

    matches = matcher.knnMatch(
        des1,
        des2,
        k=2
    )

    good = []

    for pair in matches:

        if len(pair) < 2:
            continue

        m, n = pair

        if m.distance < 0.75 * n.distance:
            good.append(m)

    if len(good) == 0:
        return 0

    # Feature score
    feature_score = min(
        100,
        (len(good) / max(1, min(len(kp1), len(kp2)))) * 100 * 3
    )

    geometric_score = 0

    # RANSAC geometric verification
    if len(good) >= 4:

        src_pts = np.float32([
            kp1[m.queryIdx].pt
            for m in good
        ]).reshape(-1, 1, 2)

        dst_pts = np.float32([
            kp2[m.trainIdx].pt
            for m in good
        ]).reshape(-1, 1, 2)

        try:

            _, mask = cv2.findHomography(
                src_pts,
                dst_pts,
                cv2.RANSAC,
                5.0
            )

            if mask is not None:

                inliers = int(mask.sum())

                geometric_score = min(
                    100,
                    (inliers / len(good)) * 100
                )

        except Exception:
            geometric_score = 0

    # Structural correlation
    a = p1.astype(np.float32)
    b = p2.astype(np.float32)

    correlation = cv2.matchTemplate(
        a,
        b,
        cv2.TM_CCOEFF_NORMED
    )

    structural_score = float(
        max(0, correlation.max()) * 100
    )

    # Final weighted score
    score = (
        feature_score * 0.50 +
        geometric_score * 0.30 +
        structural_score * 0.20
    )

    return round(max(0, min(100, score)), 2)


# =========================================================
# IRIS PROCESSING
# =========================================================

def detect_iris(gray):

    blurred = cv2.GaussianBlur(
        gray,
        (9, 9),
        2
    )

    circles = cv2.HoughCircles(
        blurred,
        cv2.HOUGH_GRADIENT,
        dp=1.2,
        minDist=50,
        param1=100,
        param2=30,
        minRadius=int(min(gray.shape) * 0.10),
        maxRadius=int(min(gray.shape) * 0.45)
    )

    if circles is not None:

        circles = np.round(
            circles[0]
        ).astype(int)

        # Select the largest reasonable circle
        circle = max(
            circles,
            key=lambda c: c[2]
        )

        return tuple(circle)

    # Center fallback
    h, w = gray.shape

    cx = w // 2
    cy = h // 2
    r = int(min(h, w) * 0.30)

    return cx, cy, r


def iris_normalize(image):

    gray = gray_resize(
        image,
        size=(500, 500)
    )

    if gray is None:
        return None

    # Detect iris
    cx, cy, radius = detect_iris(gray)

    # Polar transformation
    normalized = cv2.warpPolar(
        gray,
        (360, 120),
        (cx, cy),
        radius,
        cv2.WARP_POLAR_LINEAR
    )

    # Contrast enhancement
    clahe = cv2.createCLAHE(
        clipLimit=2.0,
        tileGridSize=(8, 8)
    )

    normalized = clahe.apply(
        normalized
    )

    normalized = cv2.GaussianBlur(
        normalized,
        (3, 3),
        0
    )

    return normalized


def iris_code(image):

    normalized = iris_normalize(image)

    if normalized is None:
        return None

    # Gradient information
    gx = cv2.Sobel(
        normalized,
        cv2.CV_32F,
        1,
        0,
        ksize=3
    )

    gy = cv2.Sobel(
        normalized,
        cv2.CV_32F,
        0,
        1,
        ksize=3
    )

    magnitude = cv2.magnitude(
        gx,
        gy
    )

    # Binary representation
    threshold = np.mean(magnitude)

    code = magnitude > threshold

    return code


def iris_hamming_distance(code1, code2):

    if code1 is None or code2 is None:
        return 1.0

    if code1.shape != code2.shape:
        return 1.0

    return np.mean(
        code1 != code2
    )


def iris_similarity(img1, img2):

    code1 = iris_code(img1)
    code2 = iris_code(img2)

    if code1 is None or code2 is None:
        return 0

    best_distance = 1.0

    # Small rotational shifts
    for shift in range(-8, 9):

        shifted = np.roll(
            code2,
            shift,
            axis=1
        )

        distance = iris_hamming_distance(
            code1,
            shifted
        )

        best_distance = min(
            best_distance,
            distance
        )

    # Convert distance to similarity
    score = (
        1.0 - best_distance
    ) * 100

    return round(
        max(0, min(100, score)),
        2
    )


# =========================================================
# UI HELPERS
# =========================================================

def clear_window():

    for widget in root.winfo_children():
        widget.destroy()


def create_header(parent, title, subtitle=""):

    header = tk.Frame(
        parent,
        bg=NAVY,
        height=90
    )

    header.pack(
        fill="x"
    )

    header.pack_propagate(False)

    left = tk.Frame(
        header,
        bg=NAVY
    )

    left.pack(
        side="left",
        padx=28
    )

    tk.Label(
        left,
        text=title,
        font=("Arial", 22, "bold"),
        bg=NAVY,
        fg=WHITE
    ).pack(
        anchor="w",
        pady=(12, 0)
    )

    if subtitle:

        tk.Label(
            left,
            text=subtitle,
            font=("Arial", 10),
            bg=NAVY,
            fg="#C8D8E8"
        ).pack(
            anchor="w"
        )

    return header


def create_button(
    parent,
    text,
    command,
    width=18,
    bg=BLUE,
    fg=WHITE
):

    return tk.Button(
        parent,
        text=text,
        command=command,
        width=width,
        font=("Arial", 11, "bold"),
        bg=bg,
        fg=fg,
        activebackground=CYAN,
        activeforeground=WHITE,
        relief="flat",
        bd=0,
        cursor="hand2",
        padx=8,
        pady=8
    )


def create_card(
    parent,
    title,
    description,
    icon,
    command
):

    card = tk.Frame(
        parent,
        bg=WHITE,
        highlightbackground=LIGHT_GRAY,
        highlightthickness=1
    )

    card.pack(
        side="left",
        fill="both",
        expand=True,
        padx=12,
        pady=10
    )

    # Icon
    icon_canvas = tk.Canvas(
        card,
        width=90,
        height=90,
        bg=LIGHT_BLUE,
        highlightthickness=0
    )

    icon_canvas.pack(
        pady=(22, 8)
    )

    if icon == "fingerprint":

        # Draw fingerprint-like curves
        for i in range(6):

            margin = 10 + i * 5

            icon_canvas.create_arc(
                margin,
                margin,
                90 - margin,
                90 - margin,
                start=20,
                extent=300,
                style="arc",
                outline=BLUE,
                width=3
            )

        icon_canvas.create_line(
            45,
            55,
            45,
            75,
            fill=BLUE,
            width=3
        )

    else:

        # Draw eye icon
        icon_canvas.create_oval(
            12,
            25,
            78,
            65,
            outline=BLUE,
            width=4
        )

        icon_canvas.create_oval(
            36,
            32,
            54,
            58,
            fill=BLUE,
            outline=BLUE
        )

        icon_canvas.create_oval(
            42,
            37,
            48,
            43,
            fill=WHITE,
            outline=WHITE
        )

    tk.Label(
        card,
        text=title,
        font=("Arial", 17, "bold"),
        bg=WHITE,
        fg=NAVY
    ).pack(
        pady=(4, 4)
    )

    tk.Label(
        card,
        text=description,
        font=("Arial", 10),
        bg=WHITE,
        fg=GRAY,
        justify="center",
        wraplength=300
    ).pack(
        padx=20,
        pady=(0, 18)
    )

    create_button(
        card,
        "OPEN MODULE",
        command,
        width=16
    ).pack(
        pady=(0, 22)
    )

    return card


